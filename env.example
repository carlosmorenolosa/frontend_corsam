# Copia este archivo como ".env" (local). En Vercel, define las variables en
# Settings > Environment Variables.
#
# Supabase: URL del proyecto y clave anon (pública; el control real lo hacen las RLS).
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<tu-anon-key>

# Opcionales: URLs de Lambdas (si no se definen, se usan las URLs por defecto del código).
# VITE_LAMBDA_OPTIMIZE=
# VITE_LAMBDA_GENERATE_BC3=
# VITE_LAMBDA_USAGE=
# VITE_LAMBDA_PRESIGNED_URL_GENERATOR=
# VITE_LAMBDA_RESULT_GETTER=

# Ya no se usan (sistema anterior de login por variables): elimínalas de Vercel.
# VITE_USER_CORSAM=
# VITE_PASSWORD_CORSAM=
